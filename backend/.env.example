# Aizen AI Builder payment configuration
# Keep all secrets only in Render/server environment variables.

SUPABASE_SERVICE_ROLE_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# NOWPayments pay currency. For USDT on Ethereum/ERC-20 use the
# currency code supported by your NOWPayments account, commonly usdterc20.
NOWPAYMENTS_PAY_CURRENCY=usdterc20

# Public webhook URL:
PAYMENT_WEBHOOK_URL=https://aizen-ai-builder.onrender.com/api/payment/webhook
